{
  "$schema": "../../../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Delta Comic",
  "version": "3.0.0-next.28",
  "identifier": "org.wenxig.delta-comic",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5174",
    "beforeDevCommand": "vp run --filter @delta-comic/app dev:web:desktop",
    "beforeBuildCommand": "vp run --filter @delta-comic/app build:web:desktop"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "url": "index.html",
        "title": "Delta Comic",
        "width": 800,
        "height": 600,
        "resizable": true,
        "visible": true,
        "focus": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": { "enable": true, "scope": ["$APPLOCALDATA/plugin/**"] }
    },
    "withGlobalTauri": false
  },
  "plugins": {
    "shell": { "open": "^(https?://|file://|/|[A-Za-z]:[\\\\/]).*" },
    "sql": { "preload": ["sqlite:app.db"] }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "homepage": "https://github.com/delta-comic",
    "license": "AGPL-3.0-only",
    "longDescription": "Delta Comic",
    "shortDescription": "Delta Comic",
    "windows": { "wix": { "language": "zh-CN" } },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}