{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "delta-comic-server",
  "main": "./app/index.ts",
  "compatibility_date": "2026-07-02",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "logs": { "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.1 },
  },
  "upload_source_maps": true,
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  // Enable this binding per deployment environment after creating the R2 bucket.
  // The catalog routes remain unavailable while the binding is absent.
  // "r2_buckets": [{ "binding": "PLUGIN_CATALOG", "bucket_name": "delta-comic-plugin-catalog" }],
  // Configure PLUGIN_PUBLIC_BASE_URL and PLUGIN_ARTIFACTS together for artifact uploads.
  "triggers": { "crons": ["0 * * * *"] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "delta-comic-server-db",
      "database_id": "b8871c90-303d-4d4b-8e87-5ff436baccd6",
      "migrations_dir": "migrations",
    },
  ],
  "vars": {
    "ACCESS_TOKEN_TTL_SECONDS": "900",
    "REFRESH_TOKEN_TTL_SECONDS": "2592000",
    "SYNC_MAX_PUSH_OPS": "100",
    "SYNC_MAX_PULL_CHANGES": "500",
  },
}