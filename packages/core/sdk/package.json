{
  "name": "@delta-comic/client",
  "version": "3.0.0-next.28",
  "description": "Delta Comic client plugin SDK",
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    "./vite": {
      "types": "./dist/vite.d.mts",
      "import": "./dist/vite.mjs"
    },
    ".": {
      "delta-comic-workspace": "./lib/index.ts",
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./manifest": {
      "types": "./dist/manifest.d.mts",
      "import": "./dist/manifest.mjs"
    },
    "./ui": {
      "types": "./dist/ui.d.mts",
      "import": "./dist/ui.mjs"
    },
    "./network": {
      "types": "./dist/network.d.mts",
      "import": "./dist/network.mjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "cordis": "catalog:",
    "kysely": "catalog:",
    "typebox": "catalog:"
  },
  "devDependencies": {
    "@delta-comic/db": "workspace:",
    "@delta-comic/downloader": "workspace:",
    "@delta-comic/manifest": "workspace:",
    "@delta-comic/model": "workspace:",
    "@delta-comic/plugin-vite": "workspace:",
    "@delta-comic/ui": "workspace:",
    "@delta-comic/utils": "workspace:",
    "@swc/core": "catalog:",
    "vue": "catalog:"
  },
  "peerDependencies": {
    "vite-plus": "catalog:",
    "vue": "catalog:"
  },
  "peerDependenciesMeta": {
    "vite-plus": {
      "optional": true
    }
  }
}