{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "declaration": true,
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "composite": true,
    "paths": { "@/*": ["./lib/*"] },
    "types": ["./env.d.ts", "./typed-router.d.ts", "@vizejs/vite-plugin"]
  },
  "contentMappers": [{ "package": "vize", "extensions": [".vue"] }],
  "include": ["env.d.ts", "lib/**/*", "src/**/*", "./package.json"]
}