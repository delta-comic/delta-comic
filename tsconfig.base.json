{
  "compilerOptions": {
    "jsx": "preserve",
    "strict": true,
    "target": "ESNext",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "customConditions": ["delta-comic-workspace"],
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "allowSyntheticDefaultImports": true,
    "noImplicitReturns": false,
    "noImplicitAny": true,
    "noImplicitOverride": true,
    "noImplicitThis": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "jsxImportSource": "vue",
    "verbatimModuleSyntax": true
  },
  "vueCompilerOptions": {
    "plugins": ["vue-router/volar/sfc-typed-router", "vue-router/volar/sfc-route-blocks"],
    "strictTemplates": true
  },
  "contentMappers": [{ "package": "vize", "extensions": [".vue"] }],
  "files": [],
  "references": [
    { "path": "./packages/app/mobile/tsconfig.json" },
    { "path": "./packages/app/desktop/tsconfig.json" },
    { "path": "./packages/app/core/tsconfig.json" },
    { "path": "./packages/core/utils/tsconfig.json" },
    { "path": "./packages/ui/ui/tsconfig.json" },
    { "path": "./packages/core/model/tsconfig.json" },
    { "path": "./packages/plugin/core/tsconfig.json" },
    { "path": "./packages/core/runtime/tsconfig.json" },
    { "path": "./packages/core/sdk/tsconfig.json" },
    { "path": "./packages/platform/db/tsconfig.json" },
    { "path": "./packages/platform/http/tsconfig.json" },
    { "path": "./tsconfig.node.json" }
  ]
}